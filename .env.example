# Frontend Site URL (used for SEO, metadataBase, canonicals, etc.)
SITE_URL=https://awaluddin.dev

# Backend API URL (where Next.js fetches dynamic content like projects, roadmap, etc.)
API_URL=http://localhost:3001/api

# Cloudflare Turnstile Site Key (for contact form captcha verification)
TURNSTILE_SITE_KEY=1x00000000000000000000AA

# GitHub Personal Access Token (for fetching live GitHub contributions and stats via GraphQL)
GITHUB_TOKEN=ghp_your_github_token_here

# SonarQube / SonarCloud Token (for code quality scanning during CI/CD)
SONAR_TOKEN=your_sonar_token_here
